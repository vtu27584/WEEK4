class Code5 {

    /*
     * Complete the 'timeConversion' function below.
     *
     * The function is expected to return a STRING.
     * The function accepts STRING s as parameter.
     */
    public static String timeConversion(String s) {
        // Extract AM or PM modifier
        String modifier = s.substring(8, 10);
        
        // Parse the hour portion into an integer
        int hour = Integer.parseInt(s.substring(0, 2));
        
        // Apply 24-hour conversion rules
        if (modifier.equals("PM")) {
            if (hour != 12) {
                hour += 12;
            }
        } else { // Handle AM cases
            if (hour == 12) {
                hour = 0;
            }
        }
        
        // Reconstruct the 24-hour time format (hh:mm:ss)
        return String.format("%02d", hour) + s.substring(2, 8);
    }
}

