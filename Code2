import java.util.Scanner;
import java.util.Arrays;

public class Code2 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (sc.hasNextInt()) {
            int t = sc.nextInt();
            while (t-- > 0) {
                String s = sc.next();
                if (isLapindrome(s)) {
                    System.out.println("YES");
                } else {
                    System.out.println("NO");
                }
            }
        }
        sc.close();
    }

    private static boolean isLapindrome(String s) {
        int n = s.length();
        
        // Frequency arrays for 'a' through 'z'
        int[] leftFreq = new int[26];
        int[] rightFreq = new int[26];
        
        // Count frequencies for the first half
        for (int i = 0; i < n / 2; i++) {
            leftFreq[s.charAt(i) - 'a']++;
        }
        
        // Skip the middle element if the length is odd
        int rightStart = (n % 2 == 0) ? (n / 2) : (n / 2 + 1);
        
        // Count frequencies for the second half
        for (int i = rightStart; i < n; i++) {
            rightFreq[s.charAt(i) - 'a']++;
        }
        
        // Compare frequencies of both halves
        return Arrays.equals(leftFreq, rightFreq);
    }
}
