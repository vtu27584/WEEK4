class Result {

    /*
     * Complete the 'matrixRotation' function below.
     *
     * The function accepts following parameters:
     *  1. 2D_INTEGER_ARRAY matrix
     *  2. INTEGER r
     */
    public static void matrixRotation(List<List<Integer>> matrix, int r) {
        int m = matrix.size();
        int n = matrix.get(0).size();
        
        // Convert to a 2D primitive array for faster access
        int[][] mat = new int[m][n];
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                mat[i][j] = matrix.get(i).get(j);
            }
        }

        int numLayers = Math.min(m, n) / 2;

        for (int layer = 0; layer < numLayers; layer++) {
            List<Integer> layerElements = new ArrayList<>();

            // 1. Traverse Top Row (left to right)
            for (int j = layer; j < n - layer; j++) {
                layerElements.add(mat[layer][j]);
            }
            // 2. Traverse Right Column (top to bottom)
            for (int i = layer + 1; i < m - layer; i++) {
                layerElements.add(mat[i][n - 1 - layer]);
            }
            // 3. Traverse Bottom Row (right to left)
            for (int j = n - 2 - layer; j >= layer; j--) {
                layerElements.add(mat[m - 1 - layer][j]);
            }
            // 4. Traverse Left Column (bottom to top)
            for (int i = m - 2 - layer; i > layer; i--) {
                layerElements.add(mat[i][layer]);
            }

            int len = layerElements.size();
            int effR = r % len; // Use modulo to handle rotations efficiently

            int idx = 0;

            // 1. Put back Top Row with clockwise offset shift (anti-clockwise movement)
            for (int j = layer; j < n - layer; j++) {
                mat[layer][j] = layerElements.get((idx + effR) % len);
                idx++;
            }
            // 2. Put back Right Column
            for (int i = layer + 1; i < m - layer; i++) {
                mat[i][n - 1 - layer] = layerElements.get((idx + effR) % len);
                idx++;
            }
            // 3. Put back Bottom Row
            for (int j = n - 2 - layer; j >= layer; j--) {
                mat[m - 1 - layer][j] = layerElements.get((idx + effR) % len);
                idx++;
            }
            // 4. Put back Left Column
            for (int i = m - 2 - layer; i > layer; i--) {
                mat[i][layer] = layerElements.get((idx + effR) % len);
                idx++;
            }
        }

        // Print the final matrix as space-separated integers per row
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                sb.append(mat[i][j]).append(j == n - 1 ? "" : " ");
            }
            sb.append("\n");
        }
        System.out.print(sb.toString());
    }
}

public class Code9 {
    public static void main(String[] args) throws IOException {
        BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(System.in));

        String[] firstMultipleInput = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");

        int m = Integer.parseInt(firstMultipleInput[0]);
        int n = Integer.parseInt(firstMultipleInput[1]);
        int r = Integer.parseInt(firstMultipleInput[2]);

        List<List<Integer>> matrix = new ArrayList<>();

        for (int i = 0; i < m; i++) {
            String[] matrixRowTempItems = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");

            List<Integer> matrixRowItems = new ArrayList<>();

            for (int j = 0; j < n; j++) {
                int matrixItem = Integer.parseInt(matrixRowTempItems[j]);
                matrixRowItems.add(matrixItem);
            }

            matrix.add(matrixRowItems);
        }

        Result.matrixRotation(matrix, r);

        bufferedReader.close();
    }
}
