class Solution {
    public boolean halvesAreAlike(String s) {
        int n = s.length();
        int count = 0;
        
        // A lookup string containing all uppercase and lowercase vowels
        String vowels = "aeiouAEIOU";
        
        // Loop through the first half and second half at the same time
        for (int i = 0; i < n / 2; i++) {
            // Increment for vowels in the first half
            if (vowels.indexOf(s.charAt(i)) != -1) {
                count++;
            }
            // Decrement for vowels in the second half
            if (vowels.indexOf(s.charAt(i + n / 2)) != -1) {
                count--;
            }
        }
        
        // If the counts balance out to 0, both halves have the same number of vowels
        return count == 0;
    }
}
